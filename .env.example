# Access from other local devices: set the host's LAN IP address.
MARATONCITO_BIND_HOST=127.0.0.1
MARATONCITO_PORT=8000

# Create a TMDB API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Obtain the API key from Prowlarr > Settings > General.
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=

# qBittorrent Web UI, with username/password when authentication is enabled.
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
